---
/* Header.astro - the white bar along the top: logo, menu links, the yellow
   WhatsApp "Enquire" button, and the ☰ menu button shown on phones.
   The data-wa attribute marks links that quote-engine.js points at WhatsApp. */
import Logo from "./Logo.astro";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import { business } from "../config/business";
---
<header><div class="hin">
<a class="brand" href="#home"><Logo /><span>{business.name}</span></a>
<nav id="nav"><a href="#home">Home</a><a href="#products">Products</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
<a class="wa" data-wa href="#contact"><WhatsAppIcon /><span class="long">Enquire on WhatsApp</span><span class="short">Enquire</span></a>
<button id="menu" aria-label="Menu" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg></button>
</div></header>
