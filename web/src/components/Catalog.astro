---
/* Catalog.astro - "Products and prices": the search box, the category tabs
   and the price list.

   The tabs and all 17 product rows are written into the HTML when the site
   is built (by src/lib/catalog-html.ts), so they can be read without running
   any script. When the page loads, quote-engine.js redraws exactly the same
   markup and from then on handles search, swiping and the Add buttons.

   class="snap" on #list is the swipeable layout the engine also sets.
   The IDs #q, #tabs and #list are used by quote-engine.js and the tests.

   Props:
     products  the catalogue in the engine's short form ({id, cat, sub?, ...}) */
import { business } from "../config/business";
import { tabsHTML, listHTML, type EngineProduct } from "../lib/catalog-html";

interface Props { products: EngineProduct[] }
const { products } = Astro.props;
---
<div id="catalog">
<h2 class="st">Products and prices</h2>
<p class="lead">Add what you need to build your estimate. Prices are per unit, in Ghana cedis.</p>
<div class="tools">
<input type="search" id="q" placeholder="Search materials" aria-label="Search materials">
<div class="tabs" id="tabs" set:html={tabsHTML(products)}></div>
<p class="hint">Swipe left or right to switch category.</p>
</div>
<div id="list" class="snap" set:html={listHTML(products, business.currencySymbol)}></div>
</div>
