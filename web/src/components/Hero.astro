---
/* Hero.astro - the opening section: headline, "View products" and
   "Call" buttons, with the cement-bag and iron-rod photos either side.
   The photos live in public/images/ (they used to be embedded inside the
   HTML as text, which made the page heavier and impossible to cache). */
import { business } from "../config/business";
---
<section class="hero" id="home">
<div class="hp l"><img alt="" src="/images/hero-left.jpg"></div>
<div class="htx"><p class="kick">Building materials supplier</p><h1>Materials for stronger construction.</h1><p class="lead">Cement, iron rods and binding wire, delivered to your site.</p><div class="ctas"><a class="cta" href="#products">View products</a><a class="btn2" href={`tel:${business.phoneInternational}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Call {business.phone}</a></div></div>
<div class="hp r"><img alt="" src="/images/hero-right.jpg"></div>
</section>
