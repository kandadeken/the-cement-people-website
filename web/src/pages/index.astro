---
/* ===========================================================================
   index.astro - the home page (thecementpeople.com/)
   ---------------------------------------------------------------------------
   Assembles the page from components, then hands the products and business
   details to the quotation engine.

   Page order (must match the original site):
     Header · Hero · category tiles · Products + Estimate · About · Contact ·
     Footer · mobile estimate bar · hidden A4 quotation ·
     data block · quotation engine

   The category tiles and the price list are written into the HTML here, at
   build time, so search engines can read all 17 products without running
   any script (see src/lib/catalog-html.ts). The engine redraws the same
   markup when the page loads and handles everything interactive.
   =========================================================================== */
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Catalog from "../components/Catalog.astro";
import EstimatePanel from "../components/EstimatePanel.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import QuotePieces from "../components/QuotePieces.astro";

import products from "../data/products.json";
import { business } from "../config/business";
import { toEngineProducts, tilesHTML } from "../lib/catalog-html";

// The products in the short form the quotation engine has always used:
// each one as {id, cat, sub?, name, unit, price}.
const engineProducts = toEngineProducts(products);

// What the quotation engine reads from the page.
const engineData = {
  currency: business.currencySymbol,
  taxRate: business.taxRate,
  business: {
    phone: business.phone,
    whatsapp: business.whatsapp,
    town: business.town,
    website: business.website,
  },
  products: engineProducts,
};
// JSON placed inside <script> must never contain "<" (it could close the tag early).
const engineJson = JSON.stringify(engineData).replace(/</g, "\\u003c");
---
<Base
  title="The Cement People"
  description="Cement, iron rods and binding wire from Krispol City, Kasoa, delivered across Kasoa and Greater Accra. See prices in Ghana cedis, build an estimate and send it on WhatsApp."
  path="/"
>
<Header />

<Hero />

<!-- Category tiles: written here at build time; quote-engine.js redraws the same markup -->
<section class="cats" id="cats" aria-label="Product categories" set:html={tilesHTML(engineProducts)}></section>

<main id="products">
<Catalog products={engineProducts} />

<EstimatePanel />
</main>

<About />
<Contact />

<Footer />

<QuotePieces />

<!-- Products and business details for quote-engine.js (read as plain data, never run) -->
<script is:inline type="application/json" id="tcp-data" set:html={engineJson}></script>
<!-- The quotation engine, loaded as an ordinary script so its variables stay global -->
<script is:inline src="/scripts/quote-engine.js"></script>
</Base>
