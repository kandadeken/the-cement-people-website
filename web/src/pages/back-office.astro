---
/* ===========================================================================
   back-office.astro - TCP Back Office (thecementpeople.com/back-office/)
   ---------------------------------------------------------------------------
   TCP's private staff app, connected to Supabase. Follows "TCP Back Office:
   Design Specification v1.1" (approved by ChatGPT and Daniel, 22 Nov 2026),
   built on "TCP Invoice Desk on Supabase: Design (v2.1)". It replaces the
   Invoice Desk; /invoice-desk/ now forwards here (invoice-desk.astro).

   SCREENS (one page; the part of the address after "#" picks the screen)
     #/                Home: what is owed, unpaid, part paid, overdue, open
                       drafts, and the latest invoices
     #/invoices        Every draft and invoice: status filters and search
     #/invoice/<id>    One invoice: a draft opens in the form (owner, sales)
                       or read-only (finance); an issued or cancelled invoice
                       is always read-only, with Share and PDF
     #/new             A new invoice (the phase 1 desk, unchanged)

   WHERE THE RULES LIVE
   Every rule (who may do what, numbering, totals, what can change) is in
   the database: supabase/migrations/. This page only asks. It holds the
   project address and the public "anon" key, which are safe in a browser;
   the secret service-role key is never here.

   CONNECTION
   The project address and anon key come from the build settings
   PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY (GitHub repository
   variables, see .github/workflows/astro-publish.yml). Without them the
   page says it is not connected and does nothing else.

   Not a tax invoice: TCP is not VAT-registered (see DOC_TITLE in
   public/scripts/back-office.js).

   Kept out of search engines: "noindex, nofollow" below, not in the
   sitemap, and no link to it anywhere on the site.
   =========================================================================== */
import "../styles/tokens.css";
import "../styles/desk.css";

import { business } from "../config/business";
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { join } from "node:path";

// Fingerprint of the Back Office script, so a phone never runs an old copy
// against a new page (the same reason as for quote-engine.js).
const deskVersion = createHash("sha256")
  .update(readFileSync(join(process.cwd(), "public/scripts/back-office.js")))
  .digest("hex")
  .slice(0, 10);

// What the desk script reads from the page: the business details printed on
// the invoice, and where the database is. Prices come from the database.
const deskData = {
  currency: business.currencySymbol,
  business: {
    name: business.name,
    phone: business.phone,
    website: business.website,
    email: business.publicEmail,
    town: business.town,
    pickup: `${business.address.area}, ${business.address.locality}`,
  },
  supabaseUrl: import.meta.env.PUBLIC_SUPABASE_URL || "",
  supabaseKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "",
  // "true" once TCP sends its own email and the template carries the
  // 6-digit code (repo variable TCP_EMAIL_CODE). Until then: link only.
  emailCode: import.meta.env.PUBLIC_TCP_EMAIL_CODE === "true",
};
const deskJson = JSON.stringify(deskData).replace(/</g, "\\u003c");
---
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<meta name="color-scheme" content="light">
<meta name="theme-color" content="#ffffff">
<title>TCP Back Office</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body class="desk">

<main id="desk" class="dk">
  <header class="dk-head">
    <img src="/brand/tcp-logo-horizontal-on-light.svg" alt="The Cement People" width="592" height="100">
    <h1>Back Office</h1>
  </header>

  <!-- Shown when this build has no database settings -->
  <section id="setup" class="dk-card" hidden>
    <h2>Not connected</h2>
    <p>This copy of the Back Office is not connected to a database yet.</p>
  </section>

  <!-- Signing in: email, then the link in the email (or a 6-digit code) -->
  <section id="signin" class="dk-card" hidden>
    <h2>Sign in</h2>
    <p class="dk-help">Enter your email. We send you a sign-in link: open it on this phone and it brings you back here, signed in. Staff are invited by the owner.</p>
    <form id="emailForm" class="dk-signin" autocomplete="on">
      <label for="email">Email</label>
      <input id="email" type="email" inputmode="email" autocomplete="email" autocapitalize="none" spellcheck="false" required>
      <button type="submit" class="dk-btn primary">Send sign-in email</button>
    </form>
    <form id="codeForm" class="dk-signin" autocomplete="off" hidden>
      <label for="code">6-digit code from the email</label>
      <input id="code" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9 ]*" required>
      <button type="submit" class="dk-btn primary">Sign in</button>
    </form>
    <p id="signMsg" class="dk-msg" role="alert"></p>
  </section>

  <!-- Signed in, but not active TCP staff -->
  <section id="noaccess" class="dk-card" hidden>
    <h2>No access</h2>
    <p>You are signed in as <b id="noEmail"></b>, but this account cannot use the Back Office.</p>
    <p id="noWhy" class="dk-help">Ask the owner to give you access.</p>
    <button type="button" id="noSignOut" class="dk-btn">Sign out</button>
  </section>

  <div id="tool" hidden>
    <div class="dk-who"><span id="who"></span><button type="button" id="signOut" class="dk-link">Sign out</button></div>
    <div id="soBox" class="dk-confirm" role="alert" hidden>
      <p id="soMsg"></p>
      <div class="dk-row">
        <a id="soOpen" class="dk-btn primary" href="#/invoices">Check it first</a>
        <button type="button" id="soGo" class="dk-btn">Sign out anyway</button>
      </div>
    </div>

    <!-- Asked before unsaved work would be replaced (spec section 5) -->
    <section id="guard" class="dk-card dk-alert" role="alertdialog" aria-labelledby="guardTitle" hidden>
      <h2 id="guardTitle">This invoice has changes that are not saved</h2>
      <p class="dk-help">Save them first, or discard them and carry on.</p>
      <div class="dk-row">
        <button type="button" id="guardSave" class="dk-btn primary">Save it</button>
        <button type="button" id="guardDiscard" class="dk-btn">Discard changes</button>
        <button type="button" id="guardBack" class="dk-btn ghost">Go back</button>
      </div>
      <p id="guardMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- Home: figures from the database (back_office_home), latest invoices -->
    <section id="homeV" hidden>
      <div id="unsavedNote"></div>
      <div class="dk-card">
        <h2>Owed to TCP</h2>
        <a id="hOwedLink" class="dk-owed" href="#/invoices?status=owed"><b id="hOwed">—</b><small>on issued invoices not yet paid</small></a>
        <div class="dk-figs">
          <a class="dk-fig" href="#/invoices?status=unpaid"><b id="hUnpaid">—</b><span>Unpaid</span></a>
          <a class="dk-fig" href="#/invoices?status=part_paid"><b id="hPart">—</b><span>Part paid</span></a>
          <a class="dk-fig warn" href="#/invoices?status=overdue"><b id="hOverdue">—</b><span>Overdue</span></a>
          <a class="dk-fig" href="#/invoices?status=draft"><b id="hDrafts">—</b><span>Open drafts</span></a>
        </div>
        <!-- Phase 2.1 (decision 1): money received today, net of refunds -->
        <a id="hTodayLink" class="dk-today" href="#/payments?period=today"><span>Received today</span><b id="hToday">—</b></a>
        <a id="hNew" class="dk-btn primary dk-wide" href="#/new">New invoice</a>
        <a class="dk-btn ghost dk-wide" href="#/notes">Search notes</a>
        <p id="homeMsg" class="dk-msg" role="alert"></p>
      </div>
      <div class="dk-card">
        <h2>Latest invoices</h2>
        <div id="recent" class="dk-list"></div>
        <a class="dk-btn dk-wide" href="#/invoices">See all invoices</a>
      </div>
    </section>

    <!-- Invoices: every draft and invoice, filters and search -->
    <section id="listV" class="dk-card" hidden>
      <h2>Invoices</h2>
      <form id="searchForm" role="search" class="dk-search">
        <label for="q" class="sr">Search by number, customer name or phone</label>
        <input id="q" type="search" autocomplete="off" placeholder="Number, name or phone">
      </form>
      <p class="dk-help dk-notes-link"><a href="#/notes">Search notes</a> (staff notes on invoices and receipts)</p>
      <div id="filters" class="dk-chips" role="group" aria-label="Show">
        <button type="button" data-status="all">All</button>
        <button type="button" data-status="draft">Drafts</button>
        <button type="button" data-status="unpaid">Unpaid</button>
        <button type="button" data-status="part_paid">Part paid</button>
        <button type="button" data-status="overdue">Overdue</button>
        <button type="button" data-status="paid">Paid</button>
        <button type="button" data-status="cancelled">Cancelled</button>
      </div>
      <p id="listInfo" class="dk-help" role="status"></p>
      <div id="rows" class="dk-list"></div>
      <button type="button" id="moreBtn" class="dk-btn dk-wide" hidden>Show more</button>
      <p id="listMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- Phase 2.1: Payments, every payment, refund and correction, with the
         period's totals (design: "The Payments tab") -->
    <section id="ledV" class="dk-card" hidden>
      <h2>Payments</h2>
      <div id="periods" class="dk-chips" role="group" aria-label="Period">
        <button type="button" data-period="today">Today</button>
        <button type="button" data-period="week">This week</button>
        <button type="button" data-period="month">This month</button>
        <button type="button" data-period="all">All</button>
      </div>
      <div id="ledTotals" class="dk-ledtot" aria-live="polite">
        <p id="ledWhen" class="dk-help"></p>
        <div class="dk-net"><span>Net received</span><b id="tNet">—</b></div>
        <div class="dk-split">
          <div><span>Received</span><b id="tRec">—</b><small id="tRecBy"></small></div>
          <div id="tRefBox"><span>Refunded</span><b id="tRef">—</b><small id="tRefBy"></small></div>
          <div><span>Records</span><b id="tCount">—</b></div>
        </div>
        <p class="dk-help dk-recnote">Recorded by TCP staff. Check against the cash drawer and the MoMo and bank statements.</p>
      </div>
      <form id="ledSearchForm" role="search" class="dk-search">
        <label for="lq" class="sr">Search by receipt, invoice, customer, phone or reference</label>
        <input id="lq" type="search" autocomplete="off" placeholder="Receipt, invoice, name, phone or ref">
      </form>
      <div id="kinds" class="dk-chips" role="group" aria-label="Show">
        <button type="button" data-kind="all">All</button>
        <button type="button" data-kind="payment">Payments</button>
        <button type="button" data-kind="refund">Refunds</button>
        <button type="button" data-kind="correction">Corrections</button>
      </div>
      <div id="methods" class="dk-chips" role="group" aria-label="Method">
        <button type="button" data-method="all">Any method</button>
        <button type="button" data-method="mobile_money">MoMo</button>
        <button type="button" data-method="cash">Cash</button>
        <button type="button" data-method="bank_transfer">Bank</button>
      </div>
      <p id="ledInfo" class="dk-help" role="status"></p>
      <div id="ledRows" class="dk-list"></div>
      <button type="button" id="ledMore" class="dk-btn dk-wide" hidden>Show more</button>
      <p id="ledMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- Phase 2.2: searching every note (design "Searching notes") -->
    <section id="notesV" class="dk-card" hidden>
      <h2>Search notes</h2>
      <form id="nsForm" role="search" class="dk-search">
        <label for="nsq" class="sr">Words in the note (3 letters or more each)</label>
        <input id="nsq" type="search" autocomplete="off" placeholder="Words in the note, e.g. balance Friday">
      </form>
      <div id="nsCats" class="dk-chips" role="group" aria-label="Category">
        <button type="button" data-ncat="all">Any category</button>
        <button type="button" data-ncat="general">General</button>
        <button type="button" data-ncat="payment">Payment</button>
        <button type="button" data-ncat="delivery">Delivery</button>
        <button type="button" data-ncat="customer_request">Customer request</button>
        <button type="button" data-ncat="complaint">Complaint</button>
        <button type="button" data-ncat="stock">Stock</button>
        <button type="button" data-ncat="follow_up">Follow-up</button>
      </div>
      <div class="dk-grid">
        <div><label for="nsBy">Written by</label><select id="nsBy"><option value="">Anyone</option></select></div>
        <div><label for="nsFrom">From</label><input id="nsFrom" type="date"></div>
        <div><label for="nsTo">To</label><input id="nsTo" type="date"></div>
      </div>
      <label class="dk-check"><input type="checkbox" id="nsHide"> Leave out corrected notes</label>
      <p id="nsInfo" class="dk-help" role="status"></p>
      <div id="nsRows" class="dk-list"></div>
      <button type="button" id="nsMore" class="dk-btn dk-wide" hidden>Show more</button>
      <p id="nsMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- One invoice: the form (new invoice or a draft) or the read-only view -->
    <div id="invV" hidden>
    <!-- Start: paste the estimate -->
    <section id="start" class="dk-card">
      <h2><span class="dk-no">1</span>Customer's estimate</h2>
      <p class="dk-help">Copy the estimate message the customer sent on WhatsApp and paste it here. Or start an invoice without one.</p>
      <label for="paste" class="sr">WhatsApp estimate</label>
      <textarea id="paste" rows="6" placeholder="Hello The Cement People, … *Estimate TCP-…* …"></textarea>
      <div class="dk-row">
        <button type="button" id="readBtn" class="dk-btn primary">Read estimate</button>
        <button type="button" id="blankBtn" class="dk-btn">Start without an estimate</button>
      </div>
      <p id="readMsg" class="dk-msg" role="status"></p>
    </section>
    <div id="form" hidden>
      <!-- Customer -->
      <section class="dk-card">
        <h2><span class="dk-no">2</span>Customer</h2>
        <div class="dk-grid">
          <div><label for="cPhone">Phone</label><input id="cPhone" type="tel" inputmode="tel" autocomplete="off" placeholder="024 123 4567"></div>
          <div><label for="cName">Name</label><input id="cName" autocomplete="off"></div>
        </div>
        <div id="matches"></div>
        <p id="custPicked" class="dk-msg" role="status"></p>
      </section>

      <!-- Items -->
      <section class="dk-card">
        <h2><span class="dk-no">3</span>Items</h2>
        <p class="dk-help">Change a price if you agreed a different one with the customer. The price list does not change.</p>
        <div id="items"></div>
        <div class="dk-row">
          <label for="addSel" class="sr">Add a product</label>
          <select id="addSel"></select>
          <button type="button" id="addBtn" class="dk-btn">Add item</button>
        </div>
      </section>

      <!-- Delivery -->
      <section class="dk-card">
        <h2><span class="dk-no">4</span>Delivery</h2>
        <div class="dk-opts" role="radiogroup" aria-label="Delivery">
          <label><input type="radio" name="dl" value="pending" checked> Not agreed yet</label>
          <label><input type="radio" name="dl" value="free"> Free delivery</label>
          <label><input type="radio" name="dl" value="fee"> Delivery fee</label>
          <label><input type="radio" name="dl" value="pickup"> Customer pickup</label>
        </div>
        <div id="feeBox" class="dk-fee" hidden>
          <label for="fee">Delivery fee agreed (GH₵)</label>
          <input id="fee" type="text" inputmode="decimal" autocomplete="off" placeholder="0.00">
          <p id="feeErr" class="dk-lerr" role="alert"></p>
        </div>
        <div class="dk-grid dk-site">
          <div class="wide"><label for="cSite">Site or drop-off location</label><input id="cSite" autocomplete="off"></div>
          <div><label for="cContact">Site contact (optional)</label><input id="cContact" autocomplete="off"></div>
          <div><label for="cContactPhone">Site contact phone (optional)</label><input id="cContactPhone" type="tel" inputmode="tel" autocomplete="off"></div>
        </div>
      </section>

      <!-- Details -->
      <section class="dk-card">
        <h2><span class="dk-no">5</span>Invoice details</h2>
        <div class="dk-grid">
          <div><label for="iDue">Pay by (optional)</label><input id="iDue" type="date"></div>
          <div class="wide"><label for="iNote">Note to the customer (optional, printed on the invoice)</label><textarea id="iNote" rows="2" placeholder="e.g. MTN MoMo number and name, or bank details"></textarea></div>
        </div>
      </section>

      <!-- Summary and actions -->
      <section class="dk-card dk-sum" aria-live="polite">
        <div><span>Materials</span><b id="sMat"></b></div>
        <div><span>Delivery</span><b id="sDel"></b></div>
        <div class="dk-total"><span>Total</span><b id="sTot"></b></div>
        <p id="state" class="dk-state" role="status"></p>
        <p id="sMsg" class="dk-msg" role="alert"></p>
        <div class="dk-row">
          <button type="button" id="issueBtn" class="dk-btn primary">Issue invoice</button>
          <button type="button" id="saveBtn" class="dk-btn">Save draft</button>
        </div>
        <p class="dk-help">"Save draft" keeps it in TCP's records so you can finish later. "Issue invoice" gives it its number and locks it; then you can share the PDF.</p>
        <button type="button" id="newBtn" class="dk-btn ghost">New invoice</button>
        <button type="button" id="discardBtn" class="dk-btn ghost dk-danger" hidden>Discard draft</button>
      </section>

      <!-- Discard draft (owner only): cancelled with a reason, never deleted -->
      <section id="discardBox" class="dk-card dk-alert" hidden>
        <h2>Discard this draft?</h2>
        <p class="dk-help">It is cancelled for good: it can no longer be edited or issued. It stays in TCP's records, under "Cancelled", with your reason.</p>
        <label for="discardWhy">Reason</label>
        <input id="discardWhy" autocomplete="off" placeholder="e.g. Customer bought elsewhere">
        <div class="dk-row">
          <button type="button" id="discardYes" class="dk-btn primary">Discard draft</button>
          <button type="button" id="discardNo" class="dk-btn">Keep it</button>
        </div>
        <p id="discardMsg" class="dk-msg" role="alert"></p>
      </section>
    </div>

    <!-- Phase 2: recording a payment (design section 3) -->
    <section id="payForm" class="dk-card" hidden>
      <h2>Record payment</h2>
      <p id="payFor" class="dk-help"></p>
      <div id="payFields">
        <label for="pAmt">Amount received (GH₵)</label>
        <div class="dk-row dk-amtrow"><input id="pAmt" type="text" inputmode="decimal" autocomplete="off"><button type="button" id="pFull" class="dk-btn">Full balance</button></div>
        <p id="pAmtErr" class="dk-lerr" role="alert"></p>
        <fieldset class="dk-methods"><legend>How it was paid</legend>
          <label><input type="radio" name="pm" value="mobile_money"> Mobile Money</label>
          <label><input type="radio" name="pm" value="cash"> Cash</label>
          <label><input type="radio" name="pm" value="bank_transfer"> Bank transfer</label>
        </fieldset>
        <label for="pRef" id="pRefLabel">Reference</label>
        <input id="pRef" autocomplete="off">
        <label for="pDate">Date paid</label>
        <input id="pDate" type="date">
        <label for="pCustNote">Note to the customer (optional, printed on the receipt)</label>
        <textarea id="pCustNote" rows="2" maxlength="300" placeholder="e.g. Thank you. Balance due by Friday."></textarea>
        <label for="pIntNote">Internal note (optional, staff only)</label>
        <textarea id="pIntNote" rows="2" maxlength="500" placeholder="e.g. Paid by his brother Kwame."></textarea>
        <p id="pErr" class="dk-lerr" role="alert"></p>
        <div class="dk-row">
          <button type="button" id="pNext" class="dk-btn primary">Continue</button>
          <button type="button" id="pCancel" class="dk-btn ghost">Cancel</button>
        </div>
      </div>
      <div id="pConfirm" class="dk-confirm" hidden>
        <p id="pSummary"></p>
        <div class="dk-row">
          <button type="button" id="pYes" class="dk-btn primary">Record it</button>
          <button type="button" id="pChange" class="dk-btn">Change</button>
        </div>
      </div>
      <p id="pMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- Phase 2: correcting or refunding a payment, owner and finance only
         (design section 6) -->
    <section id="fixForm" class="dk-card" hidden>
      <h2 id="fixTitle">Correct payment</h2>
      <p id="fixFor" class="dk-help"></p>
      <div id="fixFields">
        <div id="fixMoney">
          <label for="fAmt">Amount refunded (GH₵)</label>
          <div class="dk-row dk-amtrow"><input id="fAmt" type="text" inputmode="decimal" autocomplete="off"><button type="button" id="fAll" class="dk-btn">All that is left</button></div>
          <fieldset class="dk-methods"><legend>How it was given back</legend>
            <label><input type="radio" name="fm" value="mobile_money"> Mobile Money</label>
            <label><input type="radio" name="fm" value="cash"> Cash</label>
            <label><input type="radio" name="fm" value="bank_transfer"> Bank transfer</label>
          </fieldset>
          <label for="fRef" id="fRefLabel">Reference</label>
          <input id="fRef" autocomplete="off">
        </div>
        <label for="fWhy">Reason (kept with the record)</label>
        <input id="fWhy" autocomplete="off">
        <div id="fCustNoteBox">
          <label for="fCustNote">Note to the customer (optional, printed on the refund receipt)</label>
          <textarea id="fCustNote" rows="2" maxlength="300"></textarea>
        </div>
        <label for="fIntNote">Internal note (optional, staff only)</label>
        <textarea id="fIntNote" rows="2" maxlength="500"></textarea>
        <p id="fErr" class="dk-lerr" role="alert"></p>
        <div class="dk-row">
          <button type="button" id="fNext" class="dk-btn primary">Continue</button>
          <button type="button" id="fCancel" class="dk-btn ghost">Cancel</button>
        </div>
      </div>
      <div id="fConfirm" class="dk-confirm" hidden>
        <p id="fSummary"></p>
        <div class="dk-row">
          <button type="button" id="fYes" class="dk-btn primary">Record it</button>
          <button type="button" id="fChange" class="dk-btn">Change</button>
        </div>
      </div>
      <p id="fMsg" class="dk-msg" role="alert"></p>
    </section>

    <!-- Phase 2: one receipt (payment, correction or refund), read-only -->
    <section id="rcptSec" class="dk-card" hidden>
      <h2 id="rTitle">Receipt</h2>
      <div id="rcpt"></div>
      <div id="rNotes"></div>
      <p id="rMsg" class="dk-msg" role="status"></p>
      <div id="rCopyBox" class="dk-copy" hidden>
        <label for="rCopyText">Message for the customer</label>
        <textarea id="rCopyText" rows="2" readonly></textarea>
        <button type="button" id="rCopyBtn" class="dk-btn">Copy</button>
      </div>
      <div class="dk-row">
        <button type="button" id="rShare" class="dk-btn primary">Share receipt</button>
        <button type="button" id="rPdf" class="dk-btn">Download PDF</button>
      </div>
      <p id="rInternal" class="dk-help" hidden>A correction is kept for TCP's records: it has a PDF but is not sent to the customer.</p>
      <a id="rInv" class="dk-btn ghost dk-wide" href="#/invoices">Back to the invoice</a>
    </section>

    <!-- An invoice from the database, read-only: issued, cancelled, or a
         draft seen by finance -->
    <section id="issuedSec" class="dk-card" hidden>
      <h2 id="viewTitle">Invoice</h2>
      <div id="issued"></div>
      <div id="viewLines" class="dk-vlines"></div>
      <!-- Phase 2: the invoice's receipts, and Record payment -->
      <div id="payBox" class="dk-pays" hidden>
        <h3>Payments</h3>
        <!-- An unconfirmed payment, correction or refund kept on this phone -->
        <div id="opBox" class="dk-confirm" role="status" hidden>
          <p id="opMsg"></p>
          <button type="button" id="opCheck" class="dk-btn" hidden>Check again</button>
          <a id="opOpen" class="dk-btn" href="#/invoices" hidden>Open that invoice</a>
        </div>
        <div id="payList"></div>
        <p id="paySum" class="dk-paysum"></p>
        <button type="button" id="payBtn" class="dk-btn primary dk-wide" hidden>Record payment</button>
      </div>
      <p id="iMsg" class="dk-msg" role="status"></p>
      <div id="copyBox" class="dk-copy" hidden>
        <label for="copyText">Message for the customer</label>
        <textarea id="copyText" rows="2" readonly></textarea>
        <button type="button" id="copyBtn" class="dk-btn">Copy</button>
      </div>
      <div id="shareRow" class="dk-row">
        <button type="button" id="shareBtn" class="dk-btn primary">Share invoice</button>
        <button type="button" id="pdfBtn" class="dk-btn">Download PDF</button>
      </div>
      <p id="shareHelp" class="dk-help">"Share invoice" copies a short message and opens your phone's share menu with the PDF: choose WhatsApp, then the customer, and paste the message as the caption. The PDF is always made from TCP's records, so it can be shared again at any time.</p>
      <!-- Phase 2.1: cancelling an issued invoice (owner only). Apart from
           everything else: it cannot be undone. -->
      <div id="cxBox" class="dk-danger" hidden>
        <h3>Cancel invoice</h3>
        <p id="cxHeld" class="dk-help"></p>
        <button type="button" id="cxOpen" class="dk-btn">Cancel this invoice…</button>
        <div id="cxFields" hidden>
          <label for="cxWhy">Reason (kept with the invoice)</label>
          <input id="cxWhy" autocomplete="off">
          <p id="cxErr" class="dk-lerr" role="alert"></p>
          <div class="dk-row">
            <button type="button" id="cxNext" class="dk-btn">Continue</button>
            <button type="button" id="cxBack" class="dk-btn ghost">Don't cancel</button>
          </div>
        </div>
        <div id="cxConfirm" class="dk-confirm" hidden>
          <p id="cxSummary"></p>
          <div class="dk-row">
            <button type="button" id="cxYes" class="dk-btn danger">Cancel the invoice</button>
            <button type="button" id="cxKeep" class="dk-btn">Keep it</button>
          </div>
        </div>
        <p id="cxMsg" class="dk-msg" role="alert"></p>
      </div>
      <button type="button" id="newBtn2" class="dk-btn ghost">New invoice</button>
    </section>

    <!-- Phase 2.2: the invoice's internal notes (staff only, never sent to
         the customer), under the draft form or the invoice view -->
    <section id="notesSec" class="dk-card" hidden>
      <h2>Internal notes</h2>
      <p class="dk-help">Staff only. Never on the invoice, a receipt or WhatsApp. Notes are never edited: a mistake is fixed with Correct this note.</p>
      <div id="nEst" class="dk-note dk-note-est" hidden></div>
      <div id="nList"></div>
      <div id="nAdd">
        <label for="nBody" id="nBodyLabel">Add a note</label>
        <textarea id="nBody" rows="3" maxlength="1000"></textarea>
        <fieldset id="nCats" class="dk-methods"><legend>Category</legend>
          <label><input type="radio" name="ncat" value="general" checked> General</label>
          <label><input type="radio" name="ncat" value="payment"> Payment</label>
          <label><input type="radio" name="ncat" value="delivery"> Delivery</label>
          <label><input type="radio" name="ncat" value="customer_request"> Customer request</label>
          <label><input type="radio" name="ncat" value="complaint"> Complaint</label>
          <label><input type="radio" name="ncat" value="stock"> Stock</label>
          <label><input type="radio" name="ncat" value="follow_up"> Follow-up</label>
        </fieldset>
        <button type="button" id="nSave" class="dk-btn primary">Save note</button>
      </div>
      <p id="nNeedSave" class="dk-help" hidden>Save the draft first, then notes can be added.</p>
      <p id="nMsg" class="dk-msg" role="alert"></p>
    </section>
    </div>

    <!-- Tab bar (phone: along the bottom) -->
    <nav id="tabs" class="dk-tabs" aria-label="Back Office">
      <a href="#/" data-tab="home">Home</a>
      <a href="#/invoices" data-tab="invoices">Invoices</a>
      <a href="#/payments" data-tab="payments">Payments</a>
      <a href="#/new" data-tab="new" id="tabNew">New invoice</a>
    </nav>
  </div>
</main>

<script is:inline type="application/json" id="desk-data" set:html={deskJson}></script>
<script is:inline src="/scripts/vendor/supabase.js"></script>
<script is:inline src={`/scripts/back-office.js?v=${deskVersion}`}></script>
</body>
</html>
