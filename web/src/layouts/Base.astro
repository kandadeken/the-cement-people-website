---
/* ===========================================================================
   Base.astro - the shell every page sits inside
   ---------------------------------------------------------------------------
   Writes the <head>: page title, description, canonical address, link
   previews for WhatsApp/Facebook/X, structured data for search engines,
   the Montserrat font (hosted with the site) and the stylesheets.
   The page's own content goes where <slot /> is.

   Props:
     title        text for the browser tab and search results
     description  one or two sentences for search results and link previews
     path         this page's address on the site, e.g. "/" (for the canonical URL)
   =========================================================================== */
import { business } from "../config/business";
import { buildStructuredData } from "../lib/structured-data";
import { HERO_ALT } from "../components/Hero.astro";

// Stylesheets, in the order they must apply: brand colours, screen, print.
import "../styles/tokens.css";
import "../styles/site.css";
import "../styles/print.css";

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = "/" } = Astro.props;

// The one official address for this page (avoids duplicates in search results).
const canonical = new URL(path, business.siteUrl).href;

// Picture shown when the link is shared on WhatsApp or social media,
// with its real size and a description. 1200 x 630 is the shape WhatsApp,
// Facebook and X show best; it is cut from the wide hero photo.
const preview = {
  url: new URL("/images/hero/hero-share-1200x630.jpg", business.siteUrl).href,
  width: 1200,
  height: 630,
  alt: HERO_ALT,
};

// Machine-readable description of the business, website and page (JSON-LD).
// "<" is escaped so the text can never close the <script> tag early.
const structuredData = JSON.stringify(
  buildStructuredData({ title, description, url: canonical, image: preview.url }),
).replace(/</g, "\\u003c");
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<!-- Light or dark (17 Nov 2026, Daniel): the site follows the phone's or
     computer's own setting, and changes with it, unless the customer has
     chosen with the moon/sun button (remembered on this device). Applied
     before anything is drawn, so the page never flashes the wrong colours. -->
<script is:inline>
(()=>{const d=document.documentElement,m=matchMedia("(prefers-color-scheme: dark)");
const saved=()=>{try{const t=localStorage.getItem("tcp-theme");return t==="dark"||t==="light"?t:null}catch(e){return null}};
const apply=()=>{const t=saved()||(m.matches?"dark":"light");d.dataset.theme=t;const c=document.querySelector('meta[name="theme-color"]');if(c)c.content=t==="dark"?"#262a28":"#ffffff";};
apply();if(m.addEventListener)m.addEventListener("change",apply);
window.tcpTheme={get:()=>d.dataset.theme,set:t=>{try{localStorage.setItem("tcp-theme",t)}catch(e){}apply()}};})();
</script>
<meta name="theme-color" content="#ffffff">
<!-- "light dark": the site has its own dark design, so browsers that
     force pages dark (Soul, Chrome's auto-dark, some Android browsers) leave
     it alone instead of dimming the photos and logo (17 Nov 2026). -->
<meta name="color-scheme" content="light dark">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>

<!-- Favicon (browser tabs and Google results). Files are in public/; the
     same set is at the repository root for the live site. -->
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- Link previews (WhatsApp, Facebook, X) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content={business.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={preview.url}>
<meta property="og:image:width" content={String(preview.width)}>
<meta property="og:image:height" content={String(preview.height)}>
<meta property="og:image:alt" content={preview.alt}>
<meta name="twitter:card" content="summary_large_image">

<!-- Structured data: tells search engines who and where the business is -->
<script is:inline type="application/ld+json" set:html={structuredData}></script>

<link rel="sitemap" href="/sitemap.xml">
<!-- Montserrat is hosted with the site (see styles/tokens.css); the two most used
     files are fetched early so the headline and prices draw in the right font. -->
<link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/montserrat-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
</head>
<body>
<slot />
</body>
</html>
